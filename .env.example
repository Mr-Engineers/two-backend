# Template only - contains NO secrets. Real values live in .env.local / .env.docker / your secret store (all git-ignored).
# Generate local passwords + demo API keys with:
#   python -m app.cli gen-credentials --db-host 127.0.0.1 --db-port 5432 --db-name postgres \
#       --migration-url "postgresql://postgres:<owner-password>@127.0.0.1:5432/postgres"

# ---- Runtime (one shop process; every process has its OWN values) ---------------------------------
SHOP_ID=shop-pl                       # shop-pl | shop-de | shop-ru
DATABASE_URL=                         # runtime user of THIS shop only, e.g. postgresql://shop_pl_rt:<pw>@<host>:5432/postgres?sslmode=verify-full
APP_ENV=development                   # production requires sslmode=require|verify-ca|verify-full
LOG_LEVEL=INFO
QUOTE_TTL_SECONDS=300
MOCK_PAYMENT_MODE=approve             # approve | decline  (server-side only; agents cannot choose)
MCP_ALLOWED_HOSTS=                    # extra Host patterns for /mcp behind a proxy, e.g. shop-pl.internal:*

# ---- Admin only (setup-db / migrate / seed / reset-demo) - NEVER given to a running shop ------------
MIGRATION_DATABASE_URL=               # owner/migration account
SHOP_PL_DB_PASSWORD=
SHOP_DE_DB_PASSWORD=
SHOP_RU_DB_PASSWORD=
DATABASE_URL_SHOP_PL=                 # produced by gen-credentials, consumed by scripts/run_shops.py / docker compose
DATABASE_URL_SHOP_DE=
DATABASE_URL_SHOP_RU=

# ---- Marketplace API (separate process: python scripts/run_marketplace.py, port 8010) -------------
# Runtime user of the marketplace only (never the owner account); produced by gen-credentials.
MARKETPLACE_DATABASE_URL=
MARKETPLACE_DB_PASSWORD=
# Bearer token of the proxy's service account. Unset = API open (development only; production requires it).
MARKETPLACE_API_TOKEN=
# Separate bearer token for POST /admin/scenarios/{id}/load (falls back to MARKETPLACE_API_TOKEN when unset).
MARKETPLACE_ADMIN_TOKEN=
# Disable the demo scenario loader outside the demo.
MARKETPLACE_ENABLE_ADMIN=true
# false = available_qty stays constant (repeatable demo); true = confirmed orders lower it.
MARKETPLACE_DECREMENT_STOCK=false

# ---- Local demo credentials (seed uses only their SHA-256 hashes) ---------------------------------
DEMO_API_KEY_SHOP_PL_AGENT=
DEMO_API_KEY_SHOP_PL_OTHER=
DEMO_API_KEY_SHOP_DE_AGENT=
DEMO_API_KEY_SHOP_DE_OTHER=
DEMO_API_KEY_SHOP_RU_AGENT=
DEMO_API_KEY_SHOP_RU_OTHER=

# ---- Destructive demo reset (opt-in; refused when APP_ENV=production) -----------------------------
ALLOW_DEMO_RESET=false

# Shared Supabase: set MIGRATION_DATABASE_URL, then run:
# python -m app.cli --env-file .env gen-credentials
# python -m app.cli --env-file .env bootstrap
# python scripts/run_shops.py --env-file .env
# python scripts/run_marketplace.py --env-file .env
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=0
