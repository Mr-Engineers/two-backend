                },
                {
                  "key": "offset",
                  "value": "0"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "8. Order details",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/orders/{{order_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "orders",
                "{{order_id}}"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Cart deletion: run separately before checkout",
      "item": [
        {
          "name": "Remove item (open cart)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/carts/{{cart_id}}/items/{{sku}}?",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "carts",
                "{{cart_id}}",
                "items",
                "{{sku}}"
              ],
              "query": [
                {
                  "key": "expected_version",
                  "value": "{{cart_version}}",
                  "disabled": true
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Request succeeded', () => pm.expect(pm.response.code).to.be.within(200, 299));",
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "const data = pm.response.json();",
                  "pm.environment.set('cart_id', data.id);",
                  "pm.environment.set('cart_version', data.version);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Clear cart (open cart)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/carts/{{cart_id}}/items?",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "carts",
                "{{cart_id}}",
                "items"
              ],
              "query": [
                {
                  "key": "expected_version",
                  "value": "{{cart_version}}",
                  "disabled": true
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Request succeeded', () => pm.expect(pm.response.code).to.be.within(200, 299));",
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "const data = pm.response.json();",
                  "pm.environment.set('cart_id', data.id);",
                  "pm.environment.set('cart_version', data.version);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "MCP",
      "item": [
        {
          "name": "MCP initialize",
          "request": {
            "method": "POST",
            "header": [
